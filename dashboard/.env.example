# Firebase web config. These values are public by design: they identify the
# project, they do not authorise anything. Access is enforced by Firebase Auth
# plus firestore.rules. Set the same values as GitHub Actions *variables*
# (not secrets) named FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, etc.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
