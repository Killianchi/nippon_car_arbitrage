rules_version = '2';

// nippon-margin Firestore rules.
//
// This is proprietary deal flow. The posture is:
//   * reads require an authenticated session whose UID is on the allow-list;
//   * client writes are denied everywhere EXCEPT the watchlist editor doc,
//     which is the one thing the dashboard is meant to change;
//   * the scraper bypasses all of this because it authenticates with the
//     service account through the Admin SDK.
//
// Never relax `isOwner()` to `request.auth != null`: that would let anyone
// with a Google account read the whole catalog.

service cloud.firestore {
  match /databases/{database}/documents {

    // >>> REPLACE with your Firebase Auth UID before deploying. <<<
    // Find it: Firebase console -> Authentication -> Users -> User UID,
    // or run `firebase auth:export users.json` and read it out.
    function allowedUids() {
      return [
        'REPLACE_WITH_YOUR_FIREBASE_UID'
      ];
    }

    function isOwner() {
      return request.auth != null
          && request.auth.uid in allowedUids();
    }

    // --- Read-only collections -------------------------------------------
    // The daily Actions run writes these via the service account, which is
    // not subject to these rules. Clients may only read them.
    match /listings_jp/{doc}   { allow read: if isOwner(); allow write: if false; }
    match /listings_ch/{doc}   { allow read: if isOwner(); allow write: if false; }
    match /opportunities/{doc} { allow read: if isOwner(); allow write: if false; }
    match /model_stats_daily/{doc} { allow read: if isOwner(); allow write: if false; }
    match /fx_rates/{doc}      { allow read: if isOwner(); allow write: if false; }
    match /runs/{doc}          { allow read: if isOwner(); allow write: if false; }
    match /summaries/{doc}     { allow read: if isOwner(); allow write: if false; }
    match /alerts_sent/{doc}   { allow read: if isOwner(); allow write: if false; }

    match /price_history/{doc} {
      allow read: if isOwner();
      allow write: if false;
      match /points/{point} { allow read: if isOwner(); allow write: if false; }
    }

    // --- The one writable document ---------------------------------------
    // The dashboard's watchlist editor. Cost parameters deliberately stay in
    // config.yaml: a git commit gives you history of what you believed the
    // numbers were, and nothing in the browser can change your tax rates.
    match /config/watchlist {
      allow read: if isOwner();
      allow write: if isOwner()
                   && request.resource.data.keys().hasOnly(['items', 'updated_at', 'updated_by'])
                   && request.resource.data.items is list
                   && request.resource.data.items.size() <= 100;
    }

    // Any other config doc is read-only from the client.
    match /config/{doc} { allow read: if isOwner(); allow write: if false; }

    // --- Default deny ------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
